# Copy this file to .env.production on the deployment host.
# Do not commit .env.production or put real credentials in the image.

# Host port exposed by the web service.
WEB_PORT=18080

# This value is embedded into NEXT_PUBLIC_* output during the image build.
# Replace SERVER_PUBLIC_IP with the actual server address or domain before building.
NEXT_PUBLIC_SITE_URL=http://SERVER_PUBLIC_IP:18080

# These values are used by both the MySQL image initialization and the web API.
# MYSQL_HOST is overridden to `db` by compose.yaml for the web container.
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=codeseed
MYSQL_USER=codeseed_app
MYSQL_PASSWORD=replace-with-a-long-random-app-password
MYSQL_ROOT_PASSWORD=replace-with-a-separate-long-random-root-password
MYSQL_CONNECTION_LIMIT=10

# Keep anonymous comment submission closed until the deployment is reviewed.
COMMENTS_PUBLIC=false
COMMENTS_TRUST_PROXY=false
